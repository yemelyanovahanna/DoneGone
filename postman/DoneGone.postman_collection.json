        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const registeredUser=pm.response.json(); pm.test('Registered email',()=>pm.expect(registeredUser.email).to.eql(pm.collectionVariables.get('email'))); pm.collectionVariables.set('user_id',registeredUser.id);"
            ]
          }
        }
      ]
