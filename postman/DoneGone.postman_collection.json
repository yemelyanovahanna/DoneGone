{
  "info": {
    "name": "DoneGone Stage 3 REST API",
    "description": "Етап 3 за ЛР1: перевірка REST API, позитивні та помилкові запити, Newman і Jenkins. Кожен запуск створює унікальних тестових користувачів; проєкт і завдання видаляються наприкінці успішного запуску.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "invalid_token",
      "value": "not-a-valid-jwt"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Health') {",
          "  const id=pm.variables.replaceIn('{{$guid}}');",
          "  pm.collectionVariables.set('email','newman-'+id+'@example.test');",
          "  pm.collectionVariables.set('other_email','outsider-'+id+'@example.test');",
          "  pm.collectionVariables.set('password','Newman!'+id);",
          "  pm.collectionVariables.set('project_name','Newman project '+id);",
          "  ['token','other_token','project_id','task_id'].forEach(k=>pm.collectionVariables.unset(k));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('DoneGone is healthy', () => pm.expect(pm.response.json()).to.deep.eql({status:'ok',app:'DoneGone'}));",
              "pm.test('Configured health expectation', () => pm.expect(pm.response.code).to.eql(Number(pm.environment.get('expected_health_status') || 200)));"
            ]
          }
        }
      ]
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Database schema ready', () => pm.expect(pm.response.json().status).to.eql('ready'));"
            ]
          }
        }
      ]
    },
